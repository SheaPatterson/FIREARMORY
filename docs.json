{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "FireArmory Vault",
  "colors": {
    "primary": "#ffaa28",
    "light": "#000000",
    "dark": "#ffffff"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@firearmoryvault.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://app.firearmoryvault.com"
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "changelog",
        "pages": [
          "changelog/overview"
        ]
      },
      {
        "group": "wiki",
        "pages": [
          "wiki/ballistic-data",
          "wiki/caliber-comparison",
          "wiki/overview"
        ]
      },
      {
        "group": "security",
        "pages": [
          "security/account-security",
          "security/data-storage",
          "security/encryption"
        ]
      },
      {
        "group": "collection",
        "pages": [
          "collection/adding-firearms",
          "collection/ai-organization",
          "collection/documents",
          "collection/overview",
          "collection/serial-numbers"
        ]
      },
      {
        "group": "schematics",
        "pages": [
          "schematics/overview",
          "schematics/uploading",
          "schematics/viewing"
        ]
      },
      "index",
      "faq",
      "AGENTS",
      "quickstart",
      "introduction",
      "troubleshooting",
      "account-setup"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/firearmoryvault"
    }
  },
  "fonts": {
    "family": "Lexend",
    "weight": 500
  },
  "background": {
    "color": {
      "dark": "#1e1e1e"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "markdown": {
    "schema": true
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "autogenerate": false
    }
  },
  "contextual": {
    "options": [
      "view",
      "download-pdf",
      "download-spec",
      "chatgpt",
      "mcp",
      "add-mcp",
      "cursor",
      "aistudio"
    ],
    "display": "header"
  }
}
